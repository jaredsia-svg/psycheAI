<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kindred — compatibility, decoded</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<nav class="nav">
  <a class="brand" href="/">💞 Kindred</a>
  <div class="nav-links">
    <% if (user) { %>
      <a href="/dashboard">My profile</a>
      <a href="/scan">Scan a match</a>
