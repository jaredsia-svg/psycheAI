<%- include('partials/header') %>

<div class="match-hero card">
  <p class="muted">Compatibility report</p>
  <h1><%= scanner.display_name %> <span class="accent">×</span> <%= scanned.display_name %></h1>
  <div class="score-ring" style="--pct: <%= report.total %>">
    <div class="score-inner">
      <span class="score-big"><%= report.total %></span>
      <span class="score-sub">/ 100</span>
    </div>
  </div>
  <p class="band"><%= report.band.emoji %> <strong><%= report.band.label %></strong></p>
  <p class="summary"><%= report.summary %></p>
</div>

<div class="card">
  <h2>Where the score comes from</h2>
  <div class="trait-bars">
    <% for (const d of report.dimensions) { %>
      <div class="trait-row">
        <span class="trait-label"><%= d.label %> <span class="muted">(<%= d.weight %>%)</span></span>
        <div class="bar"><div class="bar-fill" style="width: <%= d.score %>%"></div></div>
        <span class="trait-num"><%= d.score %></span>
      </div>
    <% } %>
  </div>
  <p class="muted">
    Attachment styles: <span class="pill"><%= scanner.display_name %>: <%= report.attachmentStyles[scanner.display_name] %></span>
    <span class="pill"><%= scanned.display_name %>: <%= report.attachmentStyles[scanned.display_name] %></span>
  </p>
  <% if (report.sharedInterests.length) { %>
    <p class="tag-row">Shared interests: <% for (const t of report.sharedInterests) { %><span class="tag"><%= t %></span><% } %></p>
  <% } %>
</div>

<div class="grid-2">
  <% if (report.strengths.length) { %>
  <div class="card good">
    <h2>💪 Your strengths as a pair</h2>
    <ul class="report-list"><% for (const s of report.strengths) { %><li><%= s %></li><% } %></ul>
  </div>
  <% } %>
  <% if (report.watchouts.length) { %>
  <div class="card warn">
    <h2>⚠️ Watch out for</h2>
    <ul class="report-list"><% for (const w of report.watchouts) { %><li><%= w %></li><% } %></ul>
  </div>
  <% } %>
</div>

<div class="card advice">
  <h2>🧭 How to be great together</h2>
  <ul class="report-list"><% for (const a of report.advice) { %><li><%= a %></li><% } %></ul>
</div>

<div class="cta-row">
  <a class="btn" href="/scan">Scan another match</a>
  <a class="btn btn-ghost" href="/dashboard">Back to my profile</a>
</div>

<%- include('partials/footer') %>
