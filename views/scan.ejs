<%- include('partials/header') %>

<h1>Scan a match</h1>

<% if (!profileComplete) { %>
  <div class="card notice">
    <p>You need to <a href="/profile/edit">complete your own profile</a> before you can test compatibility.</p>
  </div>
<% } %>

<% if (error) { %><div class="alert"><%= error %></div><% } %>

<div class="grid-2">
  <div class="card">
    <h2>📷 Scan with camera</h2>
    <p class="muted">Point your camera at another Kindred user's QR code.</p>
    <div class="scanner-wrap">
      <video id="scan-video" playsinline muted></video>
      <canvas id="scan-canvas" hidden></canvas>
    </div>
    <button class="btn" id="start-scan" type="button">Start camera</button>
    <p class="muted" id="scan-status"></p>
  </div>

  <div class="card">
    <h2>⌨️ Or enter the code</h2>
    <p class="muted">Every QR code has a short text code underneath it (starts with <code>KIN-</code>).</p>
    <form method="POST" action="/scan" class="stack" id="scan-form">
      <label>Their code <input name="code" id="code-input" value="<%= prefill %>" placeholder="KIN-…" required></label>
      <button class="btn" type="submit">Test our compatibility 💘</button>
    </form>
  </div>
</div>

<script src="/vendor/jsqr.js"></script>
<script src="/scan.js"></script>

<%- include('partials/footer') %>
